# Build-time environment variables.
# NOTE: This project is a Static Export (output: 'export').
# Any NEXT_PUBLIC_* vars are inlined at BUILD time. Keep secrets OUT of
# NEXT_PUBLIC_* and never commit a real .env file.
#
# Optional: public site URL used for metadata / sitemap references.
NEXT_PUBLIC_SITE_URL=https://www.nationalbulls.com
